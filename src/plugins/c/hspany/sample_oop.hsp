#include "hspany.as"

#define OBJ_NAME 0
#define OBJ_KIND 1
#define OBJ_X 2
#define OBJ_Y 3
#define OBJ_HP 4
#define OBJ_UPDATE 5
#define OBJ_DRAW 6
#define OBJ_FIELDS 7

#define OBJ_PLAYER 1
#define OBJ_ENEMY 2
#define OBJ_ITEM 3

dimtype obj, vartype("any"), 4, OBJ_FIELDS

objmax = 3

id = 0
obj(id, OBJ_NAME) = "player"
obj(id, OBJ_KIND) = OBJ_PLAYER
obj(id, OBJ_X) = 10.0
obj(id, OBJ_Y) = 2.0
obj(id, OBJ_HP) = 120
obj(id, OBJ_UPDATE) = *update_player
obj(id, OBJ_DRAW) = *draw_unit

id = 1
obj(id, OBJ_NAME) = "enemy"
obj(id, OBJ_KIND) = OBJ_ENEMY
obj(id, OBJ_X) = 20.0
obj(id, OBJ_Y) = 5.0
obj(id, OBJ_HP) = 40
obj(id, OBJ_UPDATE) = *update_enemy
obj(id, OBJ_DRAW) = *draw_unit

id = 2
obj(id, OBJ_NAME) = "potion"
obj(id, OBJ_KIND) = OBJ_ITEM
obj(id, OBJ_X) = 15.0
obj(id, OBJ_Y) = 1.0
obj(id, OBJ_HP) = 0
obj(id, OBJ_UPDATE) = *update_item
obj(id, OBJ_DRAW) = *draw_item

mes "=== hspany oop demo ==="

repeat 3
    frame = cnt
    mes "-- frame " + frame + " --"

    repeat objmax
        id = cnt
        gosub obj(id, OBJ_UPDATE)
    loop

    repeat objmax
        id = cnt
        gosub obj(id, OBJ_DRAW)
    loop
loop

stop

*update_player
obj(id, OBJ_X) = obj(id, OBJ_X) + 1.5
obj(id, OBJ_HP) = obj(id, OBJ_HP) - 1
return

*update_enemy
obj(id, OBJ_X) = obj(id, OBJ_X) - 0.75
obj(id, OBJ_HP) = obj(id, OBJ_HP) - 3
return

*update_item
obj(id, OBJ_Y) = obj(id, OBJ_Y) + 0.25
return

*draw_unit
mes obj(id, OBJ_NAME) + " kind=" + obj(id, OBJ_KIND) + " x=" + strf("%.2f", obj(id, OBJ_X)) + " hp=" + obj(id, OBJ_HP)
return

*draw_item
mes obj(id, OBJ_NAME) + " kind=" + obj(id, OBJ_KIND) + " y=" + strf("%.2f", obj(id, OBJ_Y))
return
