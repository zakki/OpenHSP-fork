@@ main

	dim sample_ints, 4
	ddim maths, 3
	sample_ints(0) = 2
	sample_ints(1) = 4
	sample_ints(2) = 6
	sample_ints(3) = 8
	fill_math maths, 1.5, 2.0

	mes "FEATURES"
	mes "" + choose_value(-1)
	mes "" + choose_value(0)
	mes "" + choose_value(7)
	mes "" + array_checksum(sample_ints, 4)
	mes "" + sequence_checksum(4)
	mes strf("%.3f", maths(0))
	mes strf("%.3f", maths(1))
	mes strf("%.3f", maths(2))
	end

dummy_00
@@ hsp
