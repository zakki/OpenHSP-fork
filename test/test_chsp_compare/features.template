@@ header
#include "hsp3cl.as"

@@ hsp_module
#module

#defcfunc choose_value int x
	if x < 0 {
		return 11
	} else : if x = 0 {
		return 22
	} else {
		return 33
	}

#defcfunc scale_value int x, int m
	return x * m + 1

#defcfunc sequence_checksum int seed, local sum, local i
	dim tmp, 4
	sum = 0
	repeat 4
		i = cnt
		tmp(i) = scale_value(seed + i, 2)
		if (tmp(i) & 1) = 1 {
			sum += tmp(i)
		} else {
			sum += 100
		}
		sum += tmp(i) * (i + 1)
	loop
	return sum

#defcfunc math_value double x, double y, local v
	v = absf(-x) + powf(y, 2.0)
	v = limitf(v, 0.5, 10.0)
	return v + sqrt(9.0) + expf(0.0) + logf(1.0)

#deffunc fill_math array dst, double x, double y
	dst(0) = math_value(x, y)
	dst(1) = double(int(3.75))
	dst(2) = limitf(absf(-2.25) + sqrt(16.0), 0.0, 10.0)
	return

#defcfunc array_checksum array src, int n, local acc, local i
	acc = 0
	repeat n
		i = cnt
		acc += src(i) * (i + 1)
	loop
	return acc

#deffunc dummy_00
	return

#global
