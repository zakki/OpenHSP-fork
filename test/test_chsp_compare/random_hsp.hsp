#include "hsp3cl.as"

#module

#defcfunc sample_random int seed, local a, local b, local c, local ok
	ok = 0
	randomize seed
	a = rnd(100)
	b = rnd(100)
	c = rnd(100)
	if (a >= 0) & (a < 100) {
		ok += 1
	}
	if (b >= 0) & (b < 100) {
		ok += 1
	}
	if (c >= 0) & (c < 100) {
		ok += 1
	}
	return a * 1000000 + b * 1000 + c + ok * 100000000
#global

	packed = sample_random(12345)

	mes "RANDOM"
	mes "" + int(packed / 1000000) \ 100
	mes "" + int(packed / 1000) \ 1000
	mes "" + packed \ 1000
	mes "" + int(packed / 100000000)
	end
