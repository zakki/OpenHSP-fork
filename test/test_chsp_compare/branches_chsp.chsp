#include "hsp3cl.as"

#chsp_module "branches_chsp"

#chsp_deffunc compute_vals array[int] vals, local[int] x, local[int] y, local[int] shift_mix, local[int] unary_mix, local[int] branch
	x = -8
	y = 3
	shift_mix = (x + 20) >> 2
	unary_mix = -(-5) + -(2)

	if x < -4 {
		branch = 11
	} else : if x = -4 {
		branch = 22
	} else {
		branch = 33
	}

	vals(0) = shift_mix
	vals(1) = unary_mix
	vals(2) = branch + y
	return
#chsp_end

#deffunc dummy_00
	return

#chsp_module_end

	dim vals, 3
	compute_vals vals
	dummy_00

	mes "BRANCHES"
	repeat 3
		mes "" + vals(cnt)
	loop
	end
