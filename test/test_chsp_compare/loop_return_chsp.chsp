#include "hsp3cl.as"

#chsp_module "loop_return_chsp"

#chsp_deffunc fill_one array[int] vals, int idx, int limit
	vals(idx) = 999
	repeat 6
		if cnt > limit {
			vals(idx) = cnt * 10 + 1
			return
		}
	loop
	return
#chsp_end

#chsp_module_end

dim vals, 4
fill_one vals, 0, 0
fill_one vals, 1, 5
fill_one vals, 2, 1
fill_one vals, 3, 10

repeat 4
	mes "" + vals(cnt)
loop

end
