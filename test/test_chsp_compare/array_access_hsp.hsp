#include "hsp3cl.as"

#module

#defcfunc pass_value int v
	return v

#deffunc copy_value array a, int slot, int v
	a(slot) = v
	return

#deffunc write_values array a, local i, local sum
	a(0) = 10
	a.5 = 123
	i = 2
	a.i = 3
	a.i+
	a.i-
	a.i++
	a.i += 2
	a.i--
	a.i -= 1
	a(i)+
	a(i)-
	a(i)++
	a(i)--
	a(i) += 3
	a(i) -= 3
	a.(i + 5) = 10
	a.(i + 5)+
	a.(i + 5)-
	a.(i + 5)++
	a.(i + 5)--
	a.(i + 5) += 2
	a.(i + 5) -= 3
	a(i + 5)+
	a(i + 5)-
	a(i + 5)++
	a(i + 5)--
	a(i + 5) += 4
	a(i + 5) -= 4
	sum = a(0) + a.i + a.5 + a.(i + 5)
	a(1) = sum
	if a.i = 4 : a(3) = 1 : else : a(3) = 0
	copy_value a, 4, a.i
	a(6) = pass_value(a.(i + 5)) + pass_value(a.i)
	return
#global

dim a, 8
write_values a

mes "" + a(0)
mes "" + a(2)
mes "" + a(3)
mes "" + a(4)
mes "" + a(5)
mes "" + a(7)
mes "" + a(1)
mes "" + a(6)

end
