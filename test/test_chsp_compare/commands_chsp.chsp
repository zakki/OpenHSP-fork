#include "hsp3cl.as"

#chsp_module "commands_chsp"

#chsp_deffunc fill_vals array[int] dst, local[int] v
	v = 10
	dst(0) = v
	v += 5
	dst(1) = v
	v -= 2
	dst(2) = v
	v *= 3
	dst(3) = v
	return
#chsp_end

#deffunc dummy_00
	return

#chsp_module_end

	dim vals, 4
	fill_vals vals
	dummy_00

	mes "COMMANDS"
	repeat 4
		mes "" + vals(cnt)
	loop
	end
