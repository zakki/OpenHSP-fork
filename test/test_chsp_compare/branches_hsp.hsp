#include "hsp3cl.as"

#module

#deffunc compute_vals array vals, local x, local y, local shift_mix, local unary_mix, local branch
	x = -8
	y = 3
	shift_mix = (x + 20) >> 2
	unary_mix = -(-5) + -(2)

	if x < -4 {
		branch = 11
	} else : if x = -4 {
		branch = 22
	} else {
		branch = 33
	}

	vals(0) = shift_mix
	vals(1) = unary_mix
	vals(2) = branch + y
	return
#global

	dim vals, 3
	compute_vals vals

	mes "BRANCHES"
	repeat 3
		mes "" + vals(cnt)
	loop
	end
