@@ header
#include "hsp3cl.as"

@@ hsp_module
#module

#deffunc fill_one array vals, int idx, int threshold
vals(idx) = 999
repeat 6
	if cnt > threshold {
		vals(idx) = cnt * 10 + 1
		return
	}
loop
return
#global
@@ chsp_c_module
#chsp_module "loop_return_chsp_c" target=c

#chsp_deffunc fill_one array[int] vals, int idx, int limit
	vals(idx) = 999
	repeat 6
		if cnt > limit {
			vals(idx) = cnt * 10 + 1
			return
		}
	loop
	return
#chsp_end

#chsp_module_end
@@ chsp_p_module
#chsp_module "loop_return_chsp_p"

#chsp_deffunc fill_one array[int] vals, int idx, int limit
	vals(idx) = 999
	repeat 6
		if cnt > limit {
			vals(idx) = cnt * 10 + 1
			return
		}
	loop
	return
#chsp_end

#chsp_module_end
@@ main

dim vals, 4
fill_one vals, 0, 0
fill_one vals, 1, 5
fill_one vals, 2, 1
fill_one vals, 3, 10

repeat 4
	mes "" + vals(cnt)
loop

end
@@ hsp
{{header}}{{hsp_module}}{{main}}
@@ chsp_c
{{header}}{{chsp_c_module}}{{main}}
@@ chsp_p
{{header}}{{chsp_p_module}}{{main}}
