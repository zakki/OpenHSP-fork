@@ shared_prelude
#include "hsp3cl.as"
@@ hsp
{{shared_prelude}}
#module

#deffunc fill_trig array vals, double angle
	vals(0) = sin(angle)
	vals(1) = cos(angle)
	vals(2) = tan(angle * 0.25)
	vals(3) = atan(1.0)
	return

#deffunc dummy_00
	return

#global

	ddim vals, 4
	fill_trig vals, 0.5

	mes "TRIG"
	repeat 4
		mes strf("%.6f", vals(cnt))
	loop
	end

@@ chsp
{{shared_prelude}}
#chsp_module "trig_chsp"

#chsp_deffunc fill_trig array[double] vals, double angle
	vals(0) = sin(angle)
	vals(1) = cos(angle)
	vals(2) = tan(angle * 0.25)
	vals(3) = atan(1.0)
	return
#chsp_end

#deffunc dummy_00
	return

#chsp_module_end

	ddim vals, 4
	fill_trig vals, 0.5

	mes "TRIG"
	repeat 4
		mes strf("%.6f", vals(cnt))
	loop
	end

	dummy_00
