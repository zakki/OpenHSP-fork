@@ header
#include "hsp3cl.as"

@@ hsp_module
#module

#deffunc fill_vals array vals, int a0, int a1, int b0, int b1
	if a0=0 : vals(0)=1 : else : if a0=10 : vals(0)=2 : else : vals(0)=3
	if a1=0 : vals(1)=1 : else : if a1=10 : vals(1)=2 : else : vals(1)=3
	if b0=5 : vals(2)=10 : else : if b0=6 : vals(2)=20 : else : vals(2)=30
	if b1=5 : vals(3)=10 : else : if b1=6 : vals(3)=20 : else : vals(3)=30
	return
#global
@@ chsp_c_module
#chsp_module "inline_else_if_chsp_c" target=c

#chsp_deffunc fill_vals array[int] vals, int a0, int a1, int b0, int b1
	if a0=0 : vals(0)=1 : else : if a0=10 : vals(0)=2 : else : vals(0)=3
	if a1=0 : vals(1)=1 : else : if a1=10 : vals(1)=2 : else : vals(1)=3
	if b0=5 : vals(2)=10 : else : if b0=6 : vals(2)=20 : else : vals(2)=30
	if b1=5 : vals(3)=10 : else : if b1=6 : vals(3)=20 : else : vals(3)=30
#chsp_end

#chsp_module_end
@@ chsp_p_module
#chsp_module "inline_else_if_chsp_p"

#chsp_deffunc fill_vals array[int] vals, int a0, int a1, int b0, int b1
	if a0=0 : vals(0)=1 : else : if a0=10 : vals(0)=2 : else : vals(0)=3
	if a1=0 : vals(1)=1 : else : if a1=10 : vals(1)=2 : else : vals(1)=3
	if b0=5 : vals(2)=10 : else : if b0=6 : vals(2)=20 : else : vals(2)=30
	if b1=5 : vals(3)=10 : else : if b1=6 : vals(3)=20 : else : vals(3)=30
#chsp_end

#chsp_module_end
@@ main

	dim vals, 4
	fill_vals vals, 10, 20, 5, 7
	repeat 4
		mes "" + vals(cnt)
	loop
	end
@@ hsp
{{header}}{{hsp_module}}{{main}}
@@ chsp_c
{{header}}{{chsp_c_module}}{{main}}
@@ chsp_p
{{header}}{{chsp_p_module}}{{main}}
