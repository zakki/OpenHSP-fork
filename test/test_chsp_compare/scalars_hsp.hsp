#include "hsp3cl.as"

#module

#defcfunc build_scalar int x, int y
	return limit(abs(x) + y, 0, 20)

#deffunc fill_scalars array vals
	vals(0) = build_scalar(-12, 5)
	vals(1) = int(7.9) + abs(-3)
	vals(2) = limit((vals(0) + vals(1)) / 2, 0, 99)
	vals(3) = vals(2) - limit(abs(-40), 0, 10)
	return
#global

	dim vals, 4
	fill_scalars vals

	mes "SCALARS"
	repeat 4
		mes "" + vals(cnt)
	loop
	end
