@@ header
@@ hsp_module
#module

#deffunc fill_vals array vals, local v
v = 0 : v += 1 : v += 2
vals(0) = v

if v = 3 {
	v += 4 : v += 5
}
vals(1) = v

repeat 2
	v += 10 : v += cnt
loop
vals(2) = v

if 1 : vals(0) += 100 : vals(1) += 200
if 0 : vals(2) += 400 : vals(0) += 800
return
#global

mes "SEP"

dim vals, 3
fill_vals vals
repeat 3
	mes "" + vals(cnt)
loop
end
@@ chsp_c_module
// statement separator regression

#chsp_module "separators_chsp_c" target=c

#chsp_deffunc fill_vals array[int] vals, local[int] v
v = 0 : v += 1 : v += 2
vals(0) = v

if v = 3 {
    v += 4 : v += 5
}
vals(1) = v

repeat 2
    v += 10 : v += cnt
loop
vals(2) = v

if 1 : vals(0) += 100 : vals(1) += 200
if 0 : vals(2) += 400 : vals(0) += 800
#chsp_end

#chsp_module_end

mes "SEP"
dim vals, 3
fill_vals(vals)
repeat 3
    mes "" + vals(cnt)
loop
