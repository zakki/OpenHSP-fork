@@ main

	mes "OPS"
	mes "" + calc_ops(13, 5, 7)
	mes "" + assign_trace(10, 5)
	mes "" + cmp_ops(3, 3)
	mes "" + cmp_ops(2, 5)
	end

dummy_00
