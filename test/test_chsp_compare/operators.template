@@ header
#include "hsp3cl.as"

@@ hsp_module
#module

#defcfunc calc_ops int a, int b, int s, local value
	value = (a + b) * (a - b)
	value = value + ((a << 2) | (b & 3))
	value = value + (a \ b)
	value = value + (a ^ b)
	value = value + (a / b)
	return value + s

#defcfunc assign_trace int a, int b, local v, local trace
	v = a
	v += b
	trace = v
	v -= 2
	trace = trace * 100 + v
	v *= 3
	trace = trace * 100 + v
	v /= 2
	trace = trace * 100 + v
	return trace

#defcfunc cmp_ops int a, int b, local out
	out = 0
	if a = b {
		out += 1
	}
	if a ! b {
		out += 2
	}
	if a < b {
		out += 4
	}
	if a > b {
		out += 8
	}
	if a <= b {
		out += 16
	}
	if a >= b {
		out += 32
	}
	return out

#deffunc dummy_00
	return

#global
