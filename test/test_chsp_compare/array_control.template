@@ header
#include "hsp3cl.as"

@@ hsp_module
#module

#deffunc emit_mix array vals, int a, int b, int c
	vals(0) = a
	vals(1) = b
	vals(2) = c
	return

#deffunc fill_control array vals, local i, local sum
	dim src, 4

	src(0) = 2
	src.1 = -3
	src(2) = 4
	src.3 = 5

	i = 1
	emit_mix vals, abs(src.i), limit(abs(src.(i + 1)) * 2, 0, 10), abs(src.0) + abs(src.1)
	if abs(src.i) = 3 : vals(3) = 1 : else : vals(3) = 0

	sum = 0
	repeat limit(abs(src.i) + 1, 0, 5)
		sum += abs(src(cnt))
	loop
	vals(4) = sum
	return

#deffunc dummy_00
	return

#global
@@ chsp_c_module
#chsp_module "array_control_chsp_c" target=c

#chsp_deffunc emit_mix array[int] vals, int a, int b, int c
	vals(0) = a
	vals(1) = b
	vals(2) = c
	return
#chsp_end

#chsp_deffunc fill_control array[int] vals, local[int[4]] src, local[int] i, local[int] sum
	src(0) = 2
	src.1 = -3
	src(2) = 4
	src.3 = 5

	i = 1
	emit_mix vals, abs(src.i), limit(abs(src.(i + 1)) * 2, 0, 10), abs(src.0) + abs(src.1)
	if abs(src.i) = 3 : vals(3) = 1 : else : vals(3) = 0

	sum = 0
	repeat limit(abs(src.i) + 1, 0, 5)
		sum += abs(src(cnt))
	loop
	vals(4) = sum
	return
#chsp_end

#deffunc dummy_00
	return

#chsp_module_end
@@ chsp_p_module
#chsp_module "array_control_chsp_p"

#chsp_deffunc emit_mix array[int] vals, int a, int b, int c
	vals(0) = a
	vals(1) = b
	vals(2) = c
	return
#chsp_end

#chsp_deffunc fill_control array[int] vals, local[int[4]] src, local[int] i, local[int] sum
	src(0) = 2
	src.1 = -3
	src(2) = 4
	src.3 = 5

	i = 1
	emit_mix vals, abs(src.i), limit(abs(src.(i + 1)) * 2, 0, 10), abs(src.0) + abs(src.1)
	if abs(src.i) = 3 : vals(3) = 1 : else : vals(3) = 0

	sum = 0
	repeat limit(abs(src.i) + 1, 0, 5)
		sum += abs(src(cnt))
	loop
	vals(4) = sum
	return
#chsp_end

#deffunc dummy_00
	return

#chsp_module_end
@@ main

dim vals, 5
fill_control vals

mes "CONTROL"
repeat 5
	mes "" + vals(cnt)
loop

end

dummy_00
@@ hsp
{{header}}{{hsp_module}}{{main}}
@@ chsp_c
{{header}}{{chsp_c_module}}{{main}}
@@ chsp_p
{{header}}{{chsp_p_module}}{{main}}
