#include "hsp3cl.as"

#chsp_module "precedence_chsp"

#chsp_defcfunc int calc_precedence int which
	if which = 0 : return 2 + 3 * 4
	if which = 1 : return (2 + 3) * 4
	if which = 2 : return 32 >> 2 + 1
	if which = 3 : return (32 >> 2) + 1
	if which = 4 : return (5 | 2) ^ 3
	if which = 5 : return 5 | (2 ^ 3)
	return -1
#chsp_end

#deffunc dummy_00
	return

#chsp_module_end

	dummy_00
	mes "PRECEDENCE"
	repeat 6
		mes "" + calc_precedence(cnt)
	loop
	end
