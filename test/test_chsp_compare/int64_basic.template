@@ header
#include "hsp3cl.as"

@@ hsp_module
#module

#defcfunc calc64 int64 a, int64 b
	return (a + b) * 2L - a / 3L

#defcfunc bitwise64 int64 a, int64 b
	return (a & b) ^ (a | b)

#defcfunc cmp64 int64 a, int64 b
	if ( a > b ) {
		return 1
	}
	return 0

#deffunc fill_int64 array arr, int64 base_val, local buf, local i
	lldim buf, 4
	buf(0) = base_val
	buf(1) = base_val + 4294967296L
	buf(2) = base_val - 5000000000L
	buf(3) = 8589934592L
	repeat 4
		i = cnt
		arr(i) = buf(i)
	loop
	return

#deffunc dummy_00
	return

#global
@@ chsp_c_module
#chsp_module "int64_basic_chsp_c" target=c

#chsp_defcfunc calc64 int64 a, int64 b -> int64
	return (a + b) * 2L - a / 3L
#chsp_end

#chsp_defcfunc bitwise64 int64 a, int64 b -> int64
	return (a & b) ^ (a | b)
#chsp_end

#chsp_defcfunc cmp64 int64 a, int64 b -> int
	if ( a > b ) {
		return 1
	}
	return 0
#chsp_end

#chsp_deffunc fill_int64 array[int64] arr, int64 base_val, local[int64[4]] buf, local[int] i
	buf(0) = base_val
	buf(1) = base_val + 4294967296L
	buf(2) = base_val - 5000000000L
	buf(3) = 8589934592L
	repeat 4
		i = cnt
		arr(i) = buf(i)
	loop
	return
#chsp_end

#deffunc dummy_00
	return

#chsp_module_end
@@ chsp_p_module
#chsp_module "int64_basic_chsp_p"

#chsp_defcfunc calc64 int64 a, int64 b -> int64
	return (a + b) * 2L - a / 3L
#chsp_end

#chsp_defcfunc bitwise64 int64 a, int64 b -> int64
	return (a & b) ^ (a | b)
#chsp_end

#chsp_defcfunc cmp64 int64 a, int64 b -> int
	if ( a > b ) {
		return 1
	}
	return 0
#chsp_end

#chsp_deffunc fill_int64 array[int64] arr, int64 base_val, local[int64[4]] buf, local[int] i
	buf(0) = base_val
	buf(1) = base_val + 4294967296L
	buf(2) = base_val - 5000000000L
	buf(3) = 8589934592L
	repeat 4
		i = cnt
		arr(i) = buf(i)
	loop
	return
#chsp_end

#deffunc dummy_00
	return

#chsp_module_end
@@ main

x = 12000000000L
y = 3000000000L
mes "" + calc64(x, y)
mes "" + bitwise64(x, y)
mes "" + cmp64(x, y)
mes "" + cmp64(y, x)

lldim arr, 4
fill_int64 arr, 7000000000L
repeat 4
	mes "" + arr(cnt)
loop

end
@@ hsp
{{header}}{{hsp_module}}{{main}}
@@ chsp_c
{{header}}{{chsp_c_module}}{{main}}
@@ chsp_p
{{header}}{{chsp_p_module}}{{main}}
