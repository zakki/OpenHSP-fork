#include "hsp3cl.as"

#chsp_module "nested_chsp"

#chsp_deffunc fill_grid array[int] grid, local[int] i, local[int] j
	repeat 2
		i = cnt
		repeat 3
			j = cnt
			grid(i * 3 + j) = i * 10 + j + 1
		loop
	loop
	return
#chsp_end

#deffunc dummy_00
	return

#chsp_module_end

	dim grid, 6
	fill_grid grid
	dummy_00

	mes "NESTED"
	repeat 2
		i = cnt
		repeat 3
			j = cnt
			mes "" + grid(i * 3 + j)
		loop
	loop
	end
