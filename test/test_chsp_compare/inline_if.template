@@ header
#include "hsp3cl.as"

@@ hsp_module
#module

#defcfunc inline_if_values local v0, local v1, local v2
	v0 = 0
	v1 = 0
	v2 = 0
	if 1 : v0 = 10
	if 0 : v0 = 20
	if 3 > 1 : v1 = 30
	if 1 = 2 : v1 = 40
	if (v0 = 10) & (v1 = 30) : v2 = 50
	return v0 * 10000 + v1 * 100 + v2

#deffunc dummy_00
	return

#global
@@ chsp_c_module
#chsp_module "inline_if_chsp_c" target=c

#chsp_defcfunc int inline_if_values local[int] v0, local[int] v1, local[int] v2
	v0 = 0
	v1 = 0
	v2 = 0
	if 1 : v0 = 10
	if 0 : v0 = 20
	if 3 > 1 : v1 = 30
	if 1 = 2 : v1 = 40
	if (v0 = 10) & (v1 = 30) : v2 = 50
	return v0 * 10000 + v1 * 100 + v2
#chsp_end

#deffunc dummy_00
	return

#chsp_module_end
@@ chsp_p_module
#chsp_module "inline_if_chsp_p"

#chsp_defcfunc int inline_if_values local[int] v0, local[int] v1, local[int] v2
	v0 = 0
	v1 = 0
	v2 = 0
	if 1 : v0 = 10
	if 0 : v0 = 20
	if 3 > 1 : v1 = 30
	if 1 = 2 : v1 = 40
	if (v0 = 10) & (v1 = 30) : v2 = 50
	return v0 * 10000 + v1 * 100 + v2
#chsp_end

#deffunc dummy_00
	return

#chsp_module_end
@@ main

	packed = inline_if_values()

	mes "INLINE_IF"
	mes "" + int(packed / 10000)
	mes "" + (int(packed / 100) \ 100)
	mes "" + (packed \ 100)
	end

dummy_00
@@ hsp
{{header}}{{hsp_module}}{{main}}
@@ chsp_c
{{header}}{{chsp_c_module}}{{main}}
@@ chsp_p
{{header}}{{chsp_p_module}}{{main}}
