#include "hsp3cl.as"

#module

#defcfunc vec_energy array v, local dot
	dot = v(0) * v(0) + v(1) * v(1) + v(2) * v(2)
	return sqrt(dot)

#deffunc vec_mix array dst, array a, array b, local clamped
	dst(0) = a(0) + b(0) * 0.5
	dst(1) = a(1) + b(1) * 0.5
	dst(2) = a(2) + b(2) * 0.5
	dst(3) = vec_energy(dst)
	clamped = limitf(absf(dst(1)), 0.0, 10.0)
	dst(4) = clamped
	return
#global

	ddim a, 3
	ddim b, 3
	ddim out, 5

	a(0) = 1.5
	a(1) = -2.0
	a(2) = 0.5
	b(0) = 2.0
	b(1) = 4.0
	b(2) = -1.0

	vec_mix out, a, b

	mes "VECTORS"
	mes strf("%.3f", out(0))
	mes strf("%.3f", out(1))
	mes strf("%.3f", out(2))
	mes strf("%.3f", out(3))
	mes strf("%.3f", out(4))
	end
