@@ header
#include "hsp3cl.as"

@@ hsp_module
#module

#deffunc fill_vals array vals, int a0, int a1
	if a0 = 1 : vals(0) = 10 : vals(0) += 1 : else {
		vals(0) = 20
		vals(0) += 2
	}

	if a1 = 1 : vals(1) = 10 : vals(1) += 1 : else {
		vals(1) = 20
		vals(1) += 2
	}
	return
#global
@@ chsp_c_module
#chsp_module "inline_else_block_chsp_c" target=c

#chsp_deffunc fill_vals array[int] vals, int a0, int a1
	if a0=1 : vals(0)=10 : vals(0)+=1 : else {
		vals(0) = 20
		vals(0) += 2
	}

	if a1=1 : vals(1)=10 : vals(1)+=1 : else {
		vals(1) = 20
		vals(1) += 2
	}
#chsp_end

#chsp_module_end
@@ chsp_p_module
#chsp_module "inline_else_block_chsp_p"

#chsp_deffunc fill_vals array[int] vals, int a0, int a1
	if a0=1 : vals(0)=10 : vals(0)+=1 : else {
		vals(0) = 20
		vals(0) += 2
	}

	if a1=1 : vals(1)=10 : vals(1)+=1 : else {
		vals(1) = 20
		vals(1) += 2
	}
#chsp_end

#chsp_module_end
@@ main

	dim vals, 2
	fill_vals vals, 1, 2
	repeat 2
		mes "" + vals(cnt)
	loop
	end
@@ hsp
{{header}}{{hsp_module}}{{main}}
@@ chsp_c
{{header}}{{chsp_c_module}}{{main}}
@@ chsp_p
{{header}}{{chsp_p_module}}{{main}}
