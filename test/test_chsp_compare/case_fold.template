@@ header
#include "hsp3cl.as"

@@ hsp_module
#module

#defcfunc helper int value
	return value * 2

#defcfunc mixvalue int Foo
	return abs(-foo) + HELPER(foo)

#deffunc fillcase array Dst, local I
	repeat 3
		i = CNT
		DST(I) = MIXVALUE(i + 1)
	loop
	return
#global
@@ chsp_c_module
#chsp_module "case_fold_chsp_c" target=c

#chsp_defcfunc int helper int value
	return value * 2
#chsp_end

#chsp_defcfunc int mixvalue int Foo
	return ABS(-foo) + HELPER(foo)
#chsp_end

#chsp_deffunc fillcase array[int] Dst, local[int] I
	repeat 3
		i = CNT
		DST(I) = MIXVALUE(i + 1)
	loop
	return
#chsp_end

#chsp_module_end
@@ chsp_p_module
#chsp_module "case_fold_chsp_p"

#chsp_defcfunc int helper int value
	return value * 2
#chsp_end

#chsp_defcfunc int mixvalue int Foo
	return ABS(-foo) + HELPER(foo)
#chsp_end

#chsp_deffunc fillcase array[int] Dst, local[int] I
	repeat 3
		i = CNT
		DST(I) = MIXVALUE(i + 1)
	loop
	return
#chsp_end

#chsp_module_end
@@ main

	dim result, 3
	FillCase RESULT

	mes "CASE_FOLD"
	mes "" + result(0)
	mes "" + result(1)
	mes "" + result(2)
	end
@@ hsp
{{header}}{{hsp_module}}{{main}}
@@ chsp_c
{{header}}{{chsp_c_module}}{{main}}
@@ chsp_p
{{header}}{{chsp_p_module}}{{main}}
