#include "hsp3cl.as"

#chsp_module "array_control_chsp"

#chsp_deffunc emit_mix array[int] vals, int a, int b, int c
	vals(0) = a
	vals(1) = b
	vals(2) = c
	return
#chsp_end

#chsp_deffunc fill_control array[int] vals, local[int[4]] src, local[int] i, local[int] sum
	src(0) = 2
	src.1 = -3
	src(2) = 4
	src.3 = 5

	i = 1
	emit_mix vals, abs(src.i), limit(abs(src.(i + 1)) * 2, 0, 10), abs(src.0) + abs(src.1)
	if abs(src.i) = 3 : vals(3) = 1 : else : vals(3) = 0

	sum = 0
	repeat limit(abs(src.i) + 1, 0, 5)
		sum += abs(src(cnt))
	loop
	vals(4) = sum
	return
#chsp_end

#deffunc dummy_00
	return

#chsp_module_end

dim vals, 5
fill_control vals
dummy_00

mes "CONTROL"
repeat 5
	mes "" + vals(cnt)
loop

end
