#include "hsp3cl.as"

#chsp_module "operators_chsp"

#chsp_defcfunc int calc_ops int a, int b, int s, local[int] value
	value = (a + b) * (a - b)
	value = value + ((a << 2) | (b & 3))
	value = value + (a \ b)
	value = value + (a ^ b)
	value = value + (a / b)
	return value + s
#chsp_end

#chsp_defcfunc int assign_trace int a, int b, local[int] v, local[int] trace
	v = a
	v += b
	trace = v
	v -= 2
	trace = trace * 100 + v
	v *= 3
	trace = trace * 100 + v
	v /= 2
	trace = trace * 100 + v
	return trace
#chsp_end

#chsp_defcfunc int cmp_ops int a, int b, local[int] out
	out = 0
	if a = b {
		out += 1
	}
	if a ! b {
		out += 2
	}
	if a < b {
		out += 4
	}
	if a > b {
		out += 8
	}
	if a <= b {
		out += 16
	}
	if a >= b {
		out += 32
	}
	return out
#chsp_end

#deffunc dummy_00
	return

#chsp_module_end

	mes "OPS"
	mes "" + calc_ops(13, 5, 7)
	mes "" + assign_trace(10, 5)
	mes "" + cmp_ops(3, 3)
	mes "" + cmp_ops(2, 5)
	end

	dummy_00
