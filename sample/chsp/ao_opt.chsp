goto *MAIN
// #define global M_PI            3.14159265358979323846

#chsp_module "ao_opt"
#chsp_defcfunc double drand
	return double(rnd(32768)) / 32768.0
#chsp_end

#chsp_defcfunc double vdot array[double] v0, array[double] v1
	return v0(0) * v1(0) + v0(1) * v1(1) + v0(2) * v1(2)
#chsp_end

#chsp_deffunc vcross array[double] c, array[double] v0, array[double] v1
	c(0) = v0(1) * v1(2) - v0(2) * v1(1)
	c(1) = v0(2) * v1(0) - v0(0) * v1(2)
	c(2) = v0(0) * v1(1) - v0(1) * v1(0)
	return
#chsp_end

#chsp_deffunc vnormalize array[double] c, local[double] len
	len = chsp_sqrt(vdot(c, c))
	c(0) /= len
	c(1) /= len
	c(2) /= len
	return
#chsp_end

#deffunc vprint array vec
	mes "(" + vec(0) + ", " + vec(1) + ", " + vec(2) + ")"
	return

#chsp_defcfunc double vadot array[double] v0, int i0, array[double] v1, int i1
	return v0(i0*3+0) * v1(i1*3+0) + v0(i0*3+1) * v1(i1*3+1) + v0(i0*3+2) * v1(i1*3+2)
#chsp_end

#chsp_deffunc vacross array[double] c, int ci, array[double] v0, int i0, array[double] v1, int i1
	c(ci*3+0) = v0(i0*3+1) * v1(i1*3+2) - v0(i0*3+2) * v1(i1*3+1)
	c(ci*3+1) = v0(i0*3+2) * v1(i1*3+0) - v0(i0*3+0) * v1(i1*3+2)
	c(ci*3+2) = v0(i0*3+0) * v1(i1*3+1) - v0(i0*3+1) * v1(i1*3+0)
	return
#chsp_end

#chsp_deffunc vanormalize array[double] c, int i, local[double] len
	len = chsp_sqrt(vadot(c, i, c, i))
	c(i*3+0) /= len
	c(i*3+1) /= len
	c(i*3+2) /= len
	return
#chsp_end

#deffunc vaprint array vec, int i
	mes "(" + vec(i*3+0) + ", " + vec(i*3+1) + ", " + vec(i*3+2) + ")"
	return

#chsp_deffunc ray_sphere_intersect array[double] spheres_center, array[double] spheres_radius, array[double] spheres_col, array[double] isect, array[double] isect_p, array[double] isect_n, array[double] ray_org, array[double] ray_dir, int no, local[double[3]] rs, local[double] b, local[double] c, local[double] d, local[double] t
	rs(0) = ray_org(0) - spheres_center(no, 0)
	rs(1) = ray_org(1) - spheres_center(no, 1)
	rs(2) = ray_org(2) - spheres_center(no, 2)

	b = vdot(rs, ray_dir)
	c = vdot(rs, rs) - spheres_radius@(no) * spheres_radius@(no)
	d = b * b - c
	if (d > 0) {
		t = -b - sqrt(d)
		if ((t > 0) && (t < isect(0))) {
			isect(0) = t
			isect(1) += 1.0

			isect(2) = spheres_col@(no, 0)
			isect(3) = spheres_col@(no, 1)
			isect(4) = spheres_col@(no, 2)

			isect_p(0) = ray_org(0) + ray_dir(0) * t
			isect_p(1) = ray_org(1) + ray_dir(1) * t
			isect_p(2) = ray_org(2) + ray_dir(2) * t

			isect_n(0) = isect_p(0) - spheres_center(no, 0)
			isect_n(1) = isect_p(1) - spheres_center(no, 1)
			isect_n(2) = isect_p(2) - spheres_center(no, 2)

			vnormalize isect_n
		}
	}
	return
#chsp_end

#chsp_deffunc ray_plane_intersect array[double] plane_p, array[double] plane_n, array[double] plane_col, array[double] isect, array[double] isect_p, array[double] isect_n, array[double] ray_org, array[double] ray_dir, local[double] rs, local[double] d, local[double] v, local[double] t
	d = - vdot(plane_p, plane_n)
	v = vdot(ray_dir, plane_n)

	if (chsp_fabs(v) < 1.0e-17) {
		return
	}

	t = - (vdot(ray_org, plane_n) + d) / v

	if ((t > 0) && (t < isect(0))) {
		isect(0) = t
		isect(1) += 1.0

		isect(2) = plane_col(0)
		isect(3) = plane_col(1)
		isect(4) = plane_col(2)

		isect_p(0) = ray_org(0) + ray_dir(0) * t
		isect_p(1) = ray_org(1) + ray_dir(1) * t
		isect_p(2) = ray_org(2) + ray_dir(2) * t

		isect_n(0) = plane_n(0)
		isect_n(1) = plane_n(1)
		isect_n(2) = plane_n(2)
	}
	return
#chsp_end

#chsp_deffunc ortho_basis array[double] basis, array[double] n
	basis(2*3+0) = n(0)
	basis(2*3+1) = n(1)
	basis(2*3+2) = n(2)
	basis(1*3+0) = 0.0
	basis(1*3+1) = 0.0
	basis(1*3+2) = 0.0

	if ((n(0) < 0.6) && (n(0) > -0.6)) {
		basis(1*3+0) = 1.0
	} else : if ((n(1) < 0.6) && (n(1) > -0.6)) {
		basis(1*3+1) = 1.0
	} else : if ((n(2) < 0.6) && (n(2) > -0.6)) {
		basis(1*3+2) = 1.0
	} else {
		basis(1*3+0) = 1.0
	}

	vacross basis, 0, basis, 1, basis, 2
	vanormalize basis, 0

	vacross basis, 1, basis, 2, basis, 0
	vanormalize basis, 1

	return
#chsp_end

#define eps 0.0001

#chsp_deffunc ambient_occlusion \
				int nao_samples,\
				array[double] spheres_center, array[double] spheres_radius, array[double] spheres_col,\
				array[double] plane_p, array[double] plane_n, array[double] plane_col,\
				array[double] col, array[double] isect, array[double] isect_p, array[double] isect_n,\
				local[int] i, local[int] j,\
				local[double[3]] p, local[double[9]] basis, local[double] occlusion, local[double] theta, local[double] phi,\
				local[double] x, local[double] y, local[double] z, local[double] rx, local[double] ry, local[double] rz,\
				local[double[3]] oray_org, local[double[3]] oray_dir, local[double[5]] occisect, local[double[3]] occisect_p, local[double[3]] occisect_n

	p(0) = isect_p(0) + eps * isect_n(0)
	p(1) = isect_p(1) + eps * isect_n(1)
	p(2) = isect_p(2) + eps * isect_n(2)

	ortho_basis basis, isect_n

	occlusion = 0.0

	repeat nao_samples
		j = cnt
		repeat nao_samples
			i = cnt
			theta = sqrt(1.0 * drand())
			phi = 2.0 * M_PI * drand()

			x = cos(phi) * theta
			y = sin(phi) * theta
			z = sqrt(1.0 - theta * theta)

			rx = x * basis(0*3+0) + y * basis(1*3+0) + z * basis(2*3+0)
			ry = x * basis(0*3+1) + y * basis(1*3+1) + z * basis(2*3+1)
			rz = x * basis(0*3+2) + y * basis(1*3+2) + z * basis(2*3+2)

			oray_org(0) = p(0)
			oray_org(1) = p(1)
			oray_org(2) = p(2)

			oray_dir(0) = rx
			oray_dir(1) = ry
			oray_dir(2) = rz

			occisect(0) = 1.0e+17
			occisect(1) = 0.0
			occisect(2) = 0.0
			occisect(3) = 0.0
			occisect(4) = 0.0

			ray_sphere_intersect spheres_center, spheres_radius, spheres_col, occisect, occisect_p, occisect_n, oray_org, oray_dir, 0
			ray_sphere_intersect spheres_center, spheres_radius, spheres_col, occisect, occisect_p, occisect_n, oray_org, oray_dir, 1
			ray_sphere_intersect spheres_center, spheres_radius, spheres_col, occisect, occisect_p, occisect_n, oray_org, oray_dir, 2
			ray_plane_intersect plane_p, plane_n, plane_col, occIsect, occisect_p, occisect_n, oray_org, oray_dir
			if (occisect(1) > 0) {
				occlusion += 1.0
			}
		loop
	loop

	occlusion = double(nao_samples * nao_samples - occlusion) / double(nao_samples * nao_samples)
	col(0) = occlusion
	col(1) = occlusion
	col(2) = occlusion
	return
#chsp_end

; モジュール最適化で削除されないようにダミー関数を置く
#deffunc dummy
	return

#chsp_module_end


*MAIN
	w = 256
	h = 256
	nsubsamples = 2
	nao_samples = 8
	screen 0, w, h
	randomize

	repeat
	gosub *INIT
	gosub *RENDER

	await 100
	loop
	end

*INIT
	ddim spheres_center, 3*3
	ddim spheres_col, 3*3

	spheres_center(0*3+0) = -2.0
	spheres_center(0*3+1) =  0.0
	spheres_center(0*3+2) = -3.5
	spheres_radius(0) = 0.5
	spheres_col(0*3+0) = 1.0
	spheres_col(0*3+1) = 0.0
	spheres_col(0*3+2) = 0.0

	spheres_center(1*3+0) = -0.5
	spheres_center(1*3+1) =  0.0
	spheres_center(1*3+2) = -3.0
	spheres_radius(1) = 0.5
	spheres_col(1*3+0) = 0.0
	spheres_col(1*3+1) = 1.0
	spheres_col(1*3+2) = 0.0

	spheres_center(2*3+0) =  1.0
	spheres_center(2*3+1) =  0.0
	spheres_center(2*3+2) = -2.2
	spheres_radius(2) = 0.5
	spheres_col(2*3+0) = 0.0
	spheres_col(2*3+1) = 0.0
	spheres_col(2*3+2) = 1.0

	plane_p(0) =  0.0
	plane_p(1) = -0.5
	plane_p(2) =  0.0

	plane_n(0) =  0.0
	plane_n(1) =  1.0
	plane_n(2) =  0.0
	plane_col(0) = 1.0
	plane_col(1) = 1.5
	plane_col(2) = 1.0
	return

*RENDER
	ddim ray_org, 3
	ddim ray_dir, 3
	ddim isect_p, 3
	ddim isect_n, 3
	ddim col, 3
	ddim buf, w, h, 3
	starttime = (gettime(5) * 60 + gettime(6)) * 1000 + gettime(7)

	repeat h
		y = double(cnt)
		repeat w
			x = double(cnt)
			cr = 0.0
			cg = 0.0
			cb = 0.0
			repeat nsubsamples
				v = double(cnt)
				repeat nsubsamples
					u = double(cnt)
					px =  (x + (u / nsubsamples) - (double(w) / 2)) / (double(w) / 2)
					py = -(y + (v / nsubsamples) - (double(h) / 2)) / (double(h) / 2)

					ray_org(0) = 0.0
					ray_org(1) = 0.0
					ray_org(2) = 0.0

					ray_dir(0) = px
					ray_dir(1) = py
					ray_dir(2) = -1.0

					vnormalize ray_dir

					isect(0) = 1.0e+17
					isect(1) = 0.0

					ray_sphere_intersect spheres_center, spheres_radius, spheres_col, isect, isect_p, isect_n, ray_org, ray_dir, 0
					ray_sphere_intersect spheres_center, spheres_radius, spheres_col, isect, isect_p, isect_n, ray_org, ray_dir, 1
					ray_sphere_intersect spheres_center, spheres_radius, spheres_col, isect, isect_p, isect_n, ray_org, ray_dir, 2
					ray_plane_intersect plane_p, plane_n, plane_col, isect, isect_p, isect_n, ray_org, ray_dir

					if (isect(1) > 0) {
						ambient_occlusion nao_samples, spheres_center, spheres_radius, spheres_col, plane_p, plane_n, plane_col, col, isect, isect_p, isect_n
						cr += col(0)
						cg += col(1)
						cb += col(2)
					}
				loop
			loop
			cr = limitf( cr / nsubsamples / nsubsamples, 0, 1 ) * 255
			cg = limitf( cg / nsubsamples / nsubsamples, 0, 1 ) * 255
			cb = limitf( cb / nsubsamples / nsubsamples, 0, 1 ) * 255
			buf(int(x), int(y), 0) = cr
			buf(int(x), int(y), 0) = cg
			buf(int(x), int(y), 0) = cb
		loop

		progress = 1.0 * (x + y * w + 1) / (w * h)

		if (y \ 20 = 0) or (y = h - 1) {
		redraw 0
		repeat h
			y = double(cnt)
			repeat w
				x = double(cnt)

				cr = buf(int(x), int(y), 0)
				cg = buf(int(x), int(y), 0)
				cb = buf(int(x), int(y), 0)
				color cr, cg, cb
				boxf x, y, x+1, y+1
			loop
		loop
		endtime = (gettime(5) * 60 + gettime(6)) * 1000 + gettime(7)
		color 255,255,255
		pos 0, 0: mes prev
		pos 0,20 : mes "->" + double(endtime - starttime) / progress / 1000 + "sec " + (100.0 * progress) + "%"
		redraw 1
		await 0
		}
	loop
	endtime = (gettime(5) * 60 + gettime(6)) * 1000 + gettime(7)
	prev = "" + double(endtime - starttime) / 1000 + "sec"
	goto *MAIN

stop
dummy
