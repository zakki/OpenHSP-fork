#defcfunc vadot array v0, int i0, array v1, int i1
	return v0(i0, 0) * v1(i1, 0) + v0(i0, 1) * v1(i1, 1) + v0(i0, 2) * v1(i1, 2)


#func global vacross "vacross" var, int, var, int, var, int
#func global vanormalize "vanormalize" var, int

#deffunc vaprint array vec, int i
	mes "(" + vec(i*3+0) + ", " + vec(i*3+1) + ", " + vec(i*3+2) + ")"
	return

#func global ray_sphere_intersect "ray_sphere_intersect" var, var, var, var, var, var, var, var, int
#func global ray_plane_intersect "ray_plane_intersect" var, var, var, var, var, var, var, var

#deffunc ortho_basis array basis, array n
	basis(2*3+0) = n(0)
	basis(2*3+1) = n(1)
	basis(2*3+2) = n(2)
	basis(1*3+0) = 0.0
	basis(1*3+1) = 0.0
	basis(1*3+2) = 0.0

	if ((n(0) < 0.6) && (n(0) > -0.6)) {
		basis(1*3+0) = 1.0
	} else : if ((n(1) < 0.6) && (n(1) > -0.6)) {
		basis(1*3+1) = 1.0
	} else : if ((n(2) < 0.6) && (n(2) > -0.6)) {
		basis(1*3+2) = 1.0
	} else {
		basis(1*3+0) = 1.0
	}

	vacross basis, 0, basis, 1, basis, 2
	vanormalize basis, 0

	vacross basis, 1, basis, 2, basis, 0
	vanormalize basis, 1

	return

#define eps 0.0001

#deffunc ambient_occlusion array col, array isect, array isect_p, array isect_n,\
				local p, local occlusion, local theta, local phi,\
				local x, local y, local z, local rx, local ry, local rz,\
				local oray_org, local oray_dir, local occIsect, local occIsect_p, local occIsect_n

	ddim oray_org, 3
	ddim oray_dir, 3
	ddim occIsect, 5
	ddim occIsect_p, 3
	ddim occIsect_n, 3
	ddim p, 3
	ddim basis, 3*3
	ddim occlusion, 3

	p(0) = isect_p(0) + eps * isect_n(0)
	p(1) = isect_p(1) + eps * isect_n(1)
	p(2) = isect_p(2) + eps * isect_n(2)

	ortho_basis basis, isect_n

	occlusion(0) = 0.0
	occlusion(1) = 0.0
	occlusion(2) = 0.0

	repeat nao_samples@
		j = cnt
		repeat nao_samples@
			i = cnt
			theta = sqrt(1.0 * drand())
			phi = 2.0 * M_PI * drand()

			x = cos(phi) * theta
			y = sin(phi) * theta
			z = sqrt(1.0 - theta * theta)

			rx = x * basis(0*3+0) + y * basis(1*3+0) + z * basis(2*3+0)
			ry = x * basis(0*3+1) + y * basis(1*3+1) + z * basis(2*3+1)
			rz = x * basis(0*3+2) + y * basis(1*3+2) + z * basis(2*3+2)

			oray_org(0) = p(0)
			oray_org(1) = p(1)
			oray_org(2) = p(2)

			oray_dir(0) = rx
			oray_dir(1) = ry
			oray_dir(2) = rz

			occIsect(0) = 1.0e+17
			occIsect(1) = 0.0
			occIsect(2) = 0.0
			occIsect(3) = 0.0
			occIsect(4) = 0.0

			ray_sphere_intersect spheres_center@, spheres_radius@, spheres_col@, occIsect, occIsect_p, occIsect_n, oray_org, oray_dir, 0
			ray_sphere_intersect spheres_center@, spheres_radius@, spheres_col@, occIsect, occIsect_p, occIsect_n, oray_org, oray_dir, 1
			ray_sphere_intersect spheres_center@, spheres_radius@, spheres_col@, occIsect, occIsect_p, occIsect_n, oray_org, oray_dir, 2
			ray_plane_intersect plane_p@, plane_n@, plane_col@, occIsect, occIsect_p, occIsect_n, oray_org, oray_dir
			if (occIsect(1) > 0) {
				occlusion += 1.0
			}
		loop
	loop

	occlusion = double(nao_samples@ * nao_samples@ - occlusion) / double(nao_samples@ * nao_samples@)
	col(0) = occlusion
	col(1) = occlusion
	col(2) = occlusion
	return

#global


*MAIN
	w = 256
	h = 256
	nsubsamples = 2
	nao_samples = 8
	screen 0, w, h
	randomize

	/*repeat w * h
		x = int(drand() * w)
		y = int(drand() * h)

		color 0, 0, 255
		boxf x, y, x+1, y+1
	loop
	mes "OK"
	wait 1000 */
	repeat
	gosub *INIT
	gosub *RENDER

	await 100
	loop
	end

*INIT
	ddim spheres_center, 3*3
	ddim spheres_col, 3*3

	spheres_center(0*3+0) = -2.0
	spheres_center(0*3+1) =  0.0
	spheres_center(0*3+2) = -3.5
	spheres_radius(0) = 0.5
	spheres_col(0*3+0) = 1.0
	spheres_col(0*3+1) = 0.0
	spheres_col(0*3+2) = 0.0

	spheres_center(1*3+0) = -0.5
	spheres_center(1*3+1) =  0.0
	spheres_center(1*3+2) = -3.0
	spheres_radius(1) = 0.5
	spheres_col(1*3+0) = 0.0
	spheres_col(1*3+1) = 1.0
	spheres_col(1*3+2) = 0.0

	spheres_center(2*3+0) =  1.0
	spheres_center(2*3+1) =  0.0
	spheres_center(2*3+2) = -2.2
	spheres_radius(2) = 0.5
	spheres_col(2*3+0) = 0.0
	spheres_col(2*3+1) = 0.0
	spheres_col(2*3+2) = 1.0

	plane_p(0) =  0.0
	plane_p(1) = -0.5
	plane_p(2) =  0.0

	plane_n(0) =  0.0
	plane_n(1) =  1.0
	plane_n(2) =  0.0
	plane_col(0) = 1.0
	plane_col(1) = 1.5
	plane_col(2) = 1.0
	return

*RENDER
	ddim ray_org, 3
	ddim ray_dir, 3
	ddim isect_p, 3
	ddim isect_n, 3
	ddim col, 3
	ddim buf, w, h, 3
	starttime = (gettime(5) * 60 + gettime(6)) * 1000 + gettime(7)

	repeat h
		y = double(cnt)
		repeat w
			x = double(cnt)
			cr = 0.0
			cg = 0.0
			cb = 0.0
			repeat nsubsamples
				v = double(cnt)
				repeat nsubsamples
					u = double(cnt)
					px =  (x + (u / nsubsamples) - (double(w) / 2)) / (double(w) / 2)
					py = -(y + (v / nsubsamples) - (double(h) / 2)) / (double(h) / 2)

					ray_org(0) = 0.0
					ray_org(1) = 0.0
					ray_org(2) = 0.0

					ray_dir(0) = px
					ray_dir(1) = py
					ray_dir(2) = -1.0

					vnormalize ray_dir

					isect(0) = 1.0e+17
					isect(1) = 0.0

					ray_sphere_intersect spheres_center, spheres_radius, spheres_col, isect, isect_p, isect_n, ray_org, ray_dir, 0
					ray_sphere_intersect spheres_center, spheres_radius, spheres_col, isect, isect_p, isect_n, ray_org, ray_dir, 1
					ray_sphere_intersect spheres_center, spheres_radius, spheres_col, isect, isect_p, isect_n, ray_org, ray_dir, 2
					ray_plane_intersect plane_p, plane_n, plane_col, isect, isect_p, isect_n, ray_org, ray_dir

					if (isect(1) > 0) {
						ambient_occlusion col, isect, isect_p, isect_n
//zz = 0.02 * isect_p(2) + 0.2
//cr += zz
						cr += col(0)
						cg += col(1)
						cb += col(2)
					}
				loop
			loop
			cr = limitf( cr / nsubsamples / nsubsamples, 0, 1 ) * 255
			cg = limitf( cg / nsubsamples / nsubsamples, 0, 1 ) * 255
			cb = limitf( cb / nsubsamples / nsubsamples, 0, 1 ) * 255
			buf(int(x), int(y), 0) = cr
			buf(int(x), int(y), 0) = cg
			buf(int(x), int(y), 0) = cb
		loop

		progress = 1.0 * (x + y * w + 1) / (w * h)

		redraw 0
		repeat h
			y = double(cnt)
			repeat w
				x = double(cnt)

				cr = buf(int(x), int(y), 0)
				cg = buf(int(x), int(y), 0)
				cb = buf(int(x), int(y), 0)
				color cr, cg, cb
				boxf x, y, x+1, y+1
			loop
		loop
		endtime = (gettime(5) * 60 + gettime(6)) * 1000 + gettime(7)
		color 255,255,255
		pos 0, 0: mes prev
		pos 0,20 : mes "->" + double(endtime - starttime) / progress / 1000 + "sec " + (100.0 * progress) + "%"
		redraw 1
		await 0
	loop
	endtime = (gettime(5) * 60 + gettime(6)) * 1000 + gettime(7)
	prev = "" + double(endtime - starttime) / 1000 + "sec"
	goto *MAIN
